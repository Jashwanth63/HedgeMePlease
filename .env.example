# Alpaca paper credentials (consumed by the spawned Alpaca MCP server)
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret
ALPACA_PAPER_TRADE=true

# Path to a local clone of https://github.com/alpacahq/alpaca-mcp-server
ALPACA_MCP_DIR=../alpaca-mcp-server

# OpenRouter (all four LLM agents). Absent key = agents off, deterministic path only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v3.2
